# Number Hunt configuration.
#
# Nothing in here is required. The game has no database, no third-party APIs and no
# secrets, so there is nothing to keep out of version control — this file exists to
# document the handful of knobs that do exist.
#
# For local use, copy to `.env` and read it with:  node --env-file=.env server/dist/index.js
# On Render, set these in the dashboard under Environment. PORT is injected for you.

# The port to listen on. Render sets this automatically; only useful locally.
# PORT=3001

# The interface to bind. Defaults to 0.0.0.0, which is what a hosted container needs.
# Set to 127.0.0.1 to keep a local server off your network.
# HOST=0.0.0.0

# Comma-separated origins allowed to open a socket. Leave unset for same-origin, which
# is how this deploys by default — the server serves the client itself. Only needed if
# you host the client somewhere separate from the socket server.
# ALLOWED_ORIGIN=https://number-hunt.onrender.com
